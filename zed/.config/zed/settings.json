{
  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
      },
      "enable_lsp_tasks": true,
    },
  },
  "git_panel": {
    "tree_view": true,
  },
  "vim_mode": true,
  "multi_cursor_modifier": "cmd_or_ctrl",
  "relative_line_numbers": "wrapped",
  "selection_highlight": false,
  "disable_ai": false,
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "ui_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "theme": "Catppuccin Mocha",
  "icon_theme": "Base Charmed Icons",
  "vim": {
    "use_system_clipboard": "always",
    "use_smartcase_find": true,
  },
  "drag_and_drop_selection": {
    "enabled": false,
  },
  "gutter": {
    "folds": false,
    "runnables": false,
    "breakpoints": false,
  },
  "indent_guides": {
    "enabled": false,
  },
  "tab_bar": {
    "show": false,
  },
  "toolbar": {
    "breadcrumbs": true,
    "agent_review": false,
    "quick_actions": false,
    "selections_menu": false,
  },
  "status_bar": {
    "active_encoding_button": "disabled",
    "active_language_button": false,
    "cursor_position_button": false,
  },
  "minimap": {
    "show": "never",
  },
  "preview_tabs": {
    "enabled": false,
  },
  "project_panel": {
    "auto_fold_dirs": false,
    "default_width": 400,
    "hide_root": true,
    "sticky_scroll": false,
    "scrollbar": {
      "show": "never",
    },
    "indent_guides": {
      "show": "never",
    },
  },
  "title_bar": {
    "show_onboarding_banner": false,
    "show_sign_in": false,
    "show_user_menu": false,
    "show_user_picture": false,
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
}
